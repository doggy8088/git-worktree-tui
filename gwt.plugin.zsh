# =============================================================================
# gwt.plugin.zsh — zsh plugin manager 的進入點
# =============================================================================
#
# oh-my-zsh 自訂 plugin、antigen、zinit、sheldon、zplug 等工具，
# 預設會 source 名為 <plugin>.plugin.zsh 的檔案。這裡只負責把實作載入
# 目前的 shell，所有邏輯都放在 gwt.zsh，方便單獨 source 或測試。
#
# 目錄用 ${0:A:h} 取得，因此不論是 symlink 或從任何路徑載入都能運作。
# =============================================================================

source "${0:A:h}/gwt.zsh"
